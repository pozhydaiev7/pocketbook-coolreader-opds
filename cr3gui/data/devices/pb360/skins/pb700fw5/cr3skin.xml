<?xml version="1.0" encoding="UTF-8"?>
<CR3Skin>
  <toolbar id="cite-toolbar-touch" size="100%,96" valign="bottom" halign="center">
    <size minvalue="0,0" maxvalue="0,0"/>
    <border widths="0,0,0,0"/>
    <background color="transparent"/>
    <button normal="cite_cancel.png" selected="cite_cancel_select.png"/>
    <button normal="cite_a.png" selected="cite_a_select.png"/>
    <button normal="cite_a+.png" selected="cite_a+_select.png"/>
    <button normal="cite_a-.png" selected="cite_a-_select.png"/>
    <button normal="cite_c+.png" selected="cite_c+_select.png"/>
    <button normal="cite_c-.png" selected="cite_c-_select.png"/>
    <button normal="cite_down.png" selected="cite_down.png"/>
    <button normal="cite_up.png" selected="cite_up.png"/>
    <button normal="cite_save.png" selected="cite_save_select.png"/>
  </toolbar>

  <toolbar id="cite-toolbar" base="cite-toolbar-touch"/>

  <toolbar id="links-toolbar-up" size="500,108" valign="bottom" halign="center">
    <border widths="16,8,16,8"/>
    <background color="transparent"/>
    <button normal="arrow_left_black.png" disabled="arrow_left_grey.png"/>
    <button normal="arrow_right_black.png" disabled="arrow_right_grey.png"/>
    <button normal="toolbar_move_none.png"/>
    <button normal="links_cancel.png"/>
  </toolbar>

  <toolbar id="links-toolbar-down" base="#links-toolbar-up"/>

  <scroll id="titlescroll" autohide="true" show-page-numbers="true" location="title" pos="-180,0" size="130,100%" valign="center" halign="right">
    <size minvalue="20,30" maxvalue="0,0"/>
    <border widths="2,2,2,2"/>
    <leftbutton normal="arrow-left-enabled_623.png" disabled="arrow-left-disabled_623.png"/>
    <rightbutton normal="arrow-right-enabled_623.png" disabled="arrow-right-disabled_623.png"/>
    <text color="#000000" face="Liberation Sans, DejaVu Sans" size="40" bold="true" italic="false" valign="center" halign="center"/>
  </scroll>

  <scroll id="menuscroll" autohide="true" show-page-numbers="true" location="status">
    <size minvalue="20,75" maxvalue="0,0"/>
    <background color="#FFFFFF"/>
    <background color="#000000" pos="0,0" size="100%,1"/>
    <leftbutton normal="scroll_arrow_left_enabled.png" disabled="scroll_arrow_left_disabled.png"/>
    <rightbutton normal="scroll_arrow_right_enabled.png" disabled="scroll_arrow_right_disabled.png"/>
    <text color="#000000" face="Liberation Sans, DejaVu Sans" size="31" bold="true" italic="false" valign="center" halign="center"/>
  </scroll>

  <scroll id="menuscroll-noautohide" base="#menuscroll" autohide="false"/>

  <scroll id="progress" base="#menuscroll">
    <hbody frame="cr3_progress_body.png" slider="cr3_progress_slider.png"/>
    <vbody frame="cr3_progress_body.png" slider="cr3_progress_slider.png"/>
  </scroll>

  <scroll id="tabs" base="#menuscroll">
    <size minvalue="20,75" maxvalue="0,0"/>
    <border widths="44,0,0,0"/>
    <background color="#FFFFFF"/>
    <background color="#000000" pos="0,0" size="100%,1"/>
    <page-bound-bottom>
      <background image="paper-bound-h4.png" vtransform="none" htransform="split" valign="top"/>
    </page-bound-bottom>
    <tab-bottom>
      <size minvalue="100,75" maxvalue="120,75"/>
      <border widths="8,4,8,4"/>
      <background image="tab-h51.png" vtransform="none" htransform="split" valign="top"/>
      <text color="#000000" face="Liberation Sans, DejaVu Sans" size="34" bold="false" italic="false" valign="center" halign="center"/>
    </tab-bottom>
    <tab-bottom-active>
      <size minvalue="80,75" maxvalue="120,75"/>
      <border widths="8,4,8,4"/>
      <background image="tab-h51.png" vtransform="none" htransform="split" valign="top"/>
      <text color="#000000" face="Liberation Sans, DejaVu Sans" size="34" bold="false" italic="false" valign="center" halign="center"/>
    </tab-bottom-active>
  </scroll>

  <scroll id="tabs-noautohide" base="#tabs" autohide="false">
    <page-bound-bottom>
      <background image="paper-bound-h4.png" vtransform="none" htransform="split" valign="top"/>
    </page-bound-bottom>
  </scroll>

  <scroll id="tabs-noautohide-sc" base="#tabs-noautohide">
    <border widths="94,0,0,0"/>
  </scroll>

  <scroll id="sscroll" autohide="true" show-page-numbers="true">
    <size minvalue="20,75" maxvalue="0,0"/>
    <background color="#FFFFFF"/>
    <background color="#000000" pos="0,0" size="100%,1"/>
    <leftbutton normal="scroll_arrow_left_enabled.png" disabled="scroll_arrow_left_disabled.png"/>
    <rightbutton normal="scroll_arrow_right_enabled.png" disabled="scroll_arrow_right_disabled.png"/>
    <vbody frame="scroll_body_vertical.png" slider="scroll_slider_vertical.png"/>
    <hbody frame="scroll_body_horizontal.png" slider="scroll_slider_horizontal.png"/>
    <upbutton normal="scroll_arrow_up_enabled.png" disabled="scroll_arrow_up_disabled.png"/>
    <downbutton normal="scroll_arrow_down_enabled.png" disabled="scroll_arrow_down_disabled.png"/>
    <text color="#000000" face="Liberation Sans, DejaVu Sans" size="31" bold="true" italic="false" valign="center" halign="center"/>
    <page-bound-bottom>
      <background image="paper-bound-h4.png" vtransform="none" htransform="split" valign="top"/>
    </page-bound-bottom>
    <tab-bottom>
      <size minvalue="100,75" maxvalue="120,75"/>
      <border widths="8,4,8,4"/>
      <background image="tab-h51.png" vtransform="none" htransform="split" valign="top"/>
      <text color="#000000" face="Liberation Sans, DejaVu Sans" size="34" bold="false" italic="false" valign="center" halign="center"/>
    </tab-bottom>
    <tab-bottom-active>
      <size minvalue="80,75" maxvalue="120,75"/>
      <border widths="8,4,8,4"/>
      <background image="tab-h51.png" vtransform="none" htransform="split" valign="top"/>
      <text color="#000000" face="Liberation Sans, DejaVu Sans" size="34" bold="false" italic="false" valign="center" halign="center"/>
    </tab-bottom-active>
  </scroll>

  <window id="dialog">
    <background color="#FFFFFF"/>
    <text color="#000000" face="Liberation Sans, DejaVu Sans" size="40" bold="true" italic="false" valign="center" halign="center"/>
    <title base="#title-main" size="100%,100">
      <background color="#FFFFFF"/>
      <background color="#000000" pos="0,-1" size="100%,1"/>
    </title>
    <client>
      <border widths="4,4,4,4"/>
      <background color="#FFFFFF"/>
      <text color="#000000" face="Liberation Sans, DejaVu Sans" size="40" bold="true" italic="false" valign="center" halign="center"/>
    </client>
    <scroll base="#titlescroll"/>
    <closebutton normal="arrow_back_623.png">
      <border widths="16,0,0,0"/>
    </closebutton>
  </window>
  <window id="dialog-rotated" base="#dialog"/>

  <window id="about" base="#dialog"/>

  <window id="cite-dialog" base="#dialog">
    <toolbar1 base="#cite-toolbar-touch"/>
  </window>
  <window id="cite-dialog-rotated" base="#cite-dialog"/>

  <window id="links-dialog" base="#dialog">
    <toolbar1 base="#links-toolbar-up"/>
    <toolbar2 base="#links-toolbar-down"/>
  </window>
  <window id="links-dialog-rotated" base="#links-dialog"/>

  <window id="dict" size="100%,38%">
    <background color="#FFFFFF"/>
    <text color="#000000" face="Liberation Sans, DejaVu Sans" size="40" bold="true" italic="false" valign="center" halign="center"/>
    <title>
      <size minvalue="0,144" maxvalue="100%,144"/>
      <border widths="24,4,16,4"/>
      <background color="#FFFFFF"/>
      <background color="#000000" pos="0,0" size="100%,1"/>
      <background color="#000000" pos="0,-1" size="100%,1"/>
      <background color="#000000" pos="0,0" size="1,100%"/>
      <background color="#000000" pos="-1,0" size="1,100%"/>
      <text color="#000000" face="Liberation Sans, DejaVu Sans" size="40" bold="true" italic="false" valign="center" halign="left"/>
    </title>
    <client>
      <border widths="16,8,24,8"/>
      <background color="#FFFFFF"/>
      <text color="#000000" face="Liberation Sans, DejaVu Sans" size="34" bold="false" italic="false" valign="center" halign="center"/>
    </client>
    <status>
      <size minvalue="0,0" maxvalue="0,0"/>
      <border widths="0,0,0,0"/>
      <background color="#FFFFFF"/>
      <text color="#FFFFFF" face="Liberation Sans, DejaVu Sans" size="1"/>
    </status>
  </window>
  <window id="dict-rotated" base="#dict"/>

  <window id="tapSettings">
    <background color="#FFFFFF"/>
    <text color="#000000" face="Liberation Sans, DejaVu Sans" size="28" bold="true" italic="false" valign="center" halign="center"/>
    <title base="#title-main"/>
    <client>
      <border widths="8,8,8,8"/>
      <background color="#FFFFFF"/>
      <text color="#000000" face="Liberation Sans, DejaVu Sans" size="28" bold="false" italic="false" valign="center" halign="center" wordwrap="true"/>
    </client>
    <closebutton normal="arrow_back_623.png">
      <border widths="16,0,0,0"/>
    </closebutton>
  </window>
  <window id="tapSettings-rotated" base="#tapSettings"/>

  <menu id="main" min-item-count="14" max-item-count="14" show-shortcuts="false" fullscreen="true">
    <border widths="0,0,16,8"/>
    <background color="#FFFFFF"/>
    <text color="#000000" face="Liberation Sans, DejaVu Sans" size="40" bold="true" italic="false" valign="center" halign="center"/>
    <title id="title-main">
      <size minvalue="0,100" maxvalue="0,100"/>
      <border widths="16,7,16,8"/>
      <background color="#FFFFFF"/>
      <background color="#000000" pos="0,-1" size="100%,1"/>
      <text color="#000000" face="Liberation Sans, DejaVu Sans" size="42" bold="true" italic="false" valign="center" halign="left"/>
    </title>
    <client>
      <background color="#FFFFFF"/>
      <background image="sheet-h79.png" pos="0,0" size="0,100%" vtransform="tile" htransform="none"/>
    </client>
    <item id="menu-item">
      <size minvalue="48,48" maxvalue="50%,100%"/>
      <border widths="70,0,25,0"/>
      <text color="#000000" face="Liberation Sans, DejaVu Sans" size="42" bold="false" italic="false" valign="top" halign="left"/>
    </item>
    <selitem base="#menu-item">
      <size minvalue="14,25" maxvalue="14,25"/>
      <background image="marker.png" color="#FFFFFF" pos="50,20" size="14,25"/>
    </selitem>
    <value id="menu-value">
      <size minvalue="48,48" maxvalue="0,0"/>
      <border widths="70,0,25,0"/>
      <text color="#333333" face="Liberation Sans, DejaVu Sans" size="35" bold="false" italic="true" valign="center" halign="right"/>
    </value>
    <separator id="menu-separator">
      <size minvalue="0,16" maxvalue="0,0"/>
      <background color="#FFFFFF" image="separator-h16.png" pos="44,0" size="-40,0" vtransform="none" htransform="tile"/>
    </separator>
    <status>
      <size minvalue="0,0" maxvalue="0,0"/>
      <border widths="0,0,0,0"/>
      <background color="#FFFFFF"/>
      <text color="#FFFFFF" face="Liberation Sans, DejaVu Sans" size="1"/>
    </status>
    <scroll base="#titlescroll"/>
    <closebutton normal="arrow_back_623.png">
      <border widths="16,0,0,0"/>
    </closebutton>
  </menu>
  <menu id="main-rotated" base="#main" min-item-count="10" max-item-count="10" fullscreen="true"/>

  <menu id="settings" base="#main" fullscreen="true">
    <item base="#menu-item">
      <text color="#000000" face="Liberation Sans, DejaVu Sans" size="42" bold="false" italic="false" valign="top" halign="left"/>
    </item>
    <value base="#menu-value">
      <text color="#000000" face="Liberation Sans, DejaVu Sans" size="35" bold="false" italic="true" valign="bottom" halign="right"/>
    </value>
  </menu>
  <menu id="settings-rotated" base="#settings" min-item-count="10" max-item-count="10"/>

  <menu id="bookmarks" base="#main">
    <item base="#menu-item">
      <text color="#000000" face="Liberation Sans, DejaVu Sans" size="35" bold="false" italic="false" valign="top" halign="left"/>
    </item>
    <value base="#menu-value">
      <text color="#000000" face="Liberation Sans, DejaVu Sans" size="28" bold="false" italic="true" valign="bottom" halign="left"/>
    </value>
  </menu>
  <menu id="bookmarks-rotated" base="#bookmarks" min-item-count="10" max-item-count="10"/>

  <menu id="recent-books" base="#bookmarks"/>
  <menu id="recent-books-rotated" base="#bookmarks-rotated"/>

  <menu id="cites-list" base="#bookmarks"/>
  <menu id="cites-list-rotated" base="#bookmarks-rotated"/>

  <menu id="touch-toc" base="#main" min-item-count="18" max-item-count="18" show-shortcuts="false" fullscreen="true">
    <title base="#title-main"/>
    <client>
      <background color="#FFFFFF"/>
      <background image="sheet-h79.png" pos="0,0" size="0,100%" vtransform="tile" htransform="none"/>
      <text color="#000000" face="Liberation Sans, DejaVu Sans" size="42" bold="false" italic="false" valign="center" halign="left"/>
    </client>
    <item id="touch-toc-item" base="#menu-item">
      <size minvalue="48,48" maxvalue="50%,100%"/>
      <border widths="60,0,20,0"/>
      <text color="#000000" face="Liberation Sans, DejaVu Sans" size="42" bold="false" italic="false" valign="center" halign="left"/>
    </item>
    <selitem base="#touch-toc-item">
      <size minvalue="1,1" maxvalue="1,1"/>
      <background image="none.png" color="#FFFFFF" pos="44,30" size="1,1"/>
    </selitem>
    <value base="#menu-value">
      <border widths="60,0,20,0"/>
      <text color="#000000" face="Liberation Sans, DejaVu Sans" size="35" bold="false" italic="true" valign="bottom" halign="right"/>
    </value>
    <separator>
      <size minvalue="0,0" maxvalue="0,0"/>
      <background color="#FFFFFF"/>
    </separator>
    <status>
      <size minvalue="0,0" maxvalue="0,0"/>
      <border widths="0,0,0,0"/>
      <background color="#FFFFFF"/>
      <text color="#FFFFFF" face="Liberation Sans, DejaVu Sans" size="1"/>
    </status>
    <scroll base="#titlescroll"/>
    <closebutton normal="arrow_back_623.png">
      <border widths="16,0,0,0"/>
    </closebutton>
  </menu>
  <!-- touch TOC with page numbers and dotted leaders: no separator lines between rows -->
  <menu id="touch-toc-dots" base="#touch-toc" min-item-count="18" max-item-count="18" fullscreen="true" >
    <separator>
      <size minvalue="0,0" maxvalue="0,0"/>
    </separator>
  </menu>
  <menu id="touch-toc-dots-rotated" base="#touch-toc-dots" min-item-count="13" max-item-count="13" fullscreen="true" >
  </menu>
  <menu id="touch-toc-rotated" base="#touch-toc" min-item-count="13" max-item-count="13" fullscreen="true"/>

  <menu id="toc" base="#main" min-item-count="18" max-item-count="18" show-shortcuts="false" fullscreen="true">
    <title base="#title-main"/>
    <client>
      <border widths="4,4,4,4"/>
      <background color="#FFFFFF"/>
      <text color="#000000" face="Liberation Sans, DejaVu Sans" size="42" bold="false" italic="false" valign="center" halign="left"/>
    </client>
    <item id="toc-item" base="#menu-item">
      <border widths="0,4,0,4"/>
      <text color="#000000" face="Liberation Sans, DejaVu Sans" size="42" bold="true" italic="false" valign="center" halign="left"/>
    </item>
    <selitem base="#toc-item">
      <border widths="0,4,0,4"/>
      <background color="#AAAAAA"/>
      <text color="#000000" face="Liberation Sans, DejaVu Sans" size="42" bold="true" italic="false" valign="center" halign="left"/>
    </selitem>
    <value base="#menu-value">
      <border widths="0,4,0,4"/>
      <text color="#000000" face="Liberation Sans, DejaVu Sans" size="42" bold="true" italic="false" valign="center" halign="right"/>
    </value>
    <input size="30%,70%" pos="68%,21%">
      <border widths="4,4,4,4"/>
      <background color="#FFFFFF"/>
      <text color="#000000" face="Liberation Sans, DejaVu Sans" size="42" bold="false" italic="false" valign="center" halign="left"/>
    </input>
    <status>
      <size minvalue="0,0" maxvalue="0,0"/>
      <border widths="0,0,0,0"/>
      <background color="#FFFFFF"/>
      <text color="#FFFFFF" face="Liberation Sans, DejaVu Sans" size="1"/>
    </status>
    <scroll base="#titlescroll"/>
  </menu>
  <menu id="toc-rotated" base="#toc" min-item-count="13" max-item-count="13" fullscreen="true"/>

  <menu id="dict-list" min-item-count="9" max-item-count="9" show-shortcuts="false" fullscreen="false">
    <!-- the list draws the title of the dict window: the same height, or the rows cover the buttons -->
    <border widths="20,4,20,0"/>
    <background color="#FFFFFF"/>
    <text color="#000000" face="Liberation Sans, DejaVu Sans" size="40" bold="true" italic="false" valign="center" halign="left"/>
    <title>
      <size minvalue="0,144" maxvalue="100%,144"/>
      <border widths="4,4,4,4"/>
      <background color="#FFFFFF"/>
      <background color="#000000" pos="0,0" size="100%,1"/>
      <background color="#000000" pos="0,-1" size="100%,1"/>
      <background color="#000000" pos="0,0" size="1,100%"/>
      <background color="#000000" pos="-1,0" size="1,100%"/>
      <text color="#000000" face="Liberation Sans, DejaVu Sans" size="40" bold="true" italic="false" valign="center" halign="left"/>
    </title>
    <client>
      <background color="#FFFFFF"/>
    </client>
    <item>
      <border widths="0,0,0,0"/>
      <text color="#000000" face="Liberation Sans, DejaVu Sans" size="39" bold="true" italic="false" valign="center" halign="left"/>
    </item>
    <selitem>
      <border widths="10,0,0,0"/>
      <text color="#000000" face="Liberation Sans, DejaVu Sans" size="39" bold="true" italic="false" valign="center" halign="left"/>
    </selitem>
    <value>
      <text color="#000000" face="Liberation Sans, DejaVu Sans" size="39" bold="false" italic="false" valign="center" halign="left"/>
    </value>
    <status>
      <size minvalue="0,0" maxvalue="0,0"/>
      <border widths="0,0,0,0"/>
      <background color="#FFFFFF"/>
      <text color="#FFFFFF" face="Liberation Sans, DejaVu Sans" size="1"/>
    </status>
  </menu>
  <menu id="dict-list-rotated" base="#dict-list" min-item-count="6" max-item-count="6"/>

  <menu id="vkeyboard" base="#toc" show-shortcuts="false">
    <border widths="8,4,8,4"/>
    <background color="#FFFFFF"/>
    <text color="#000000" face="Liberation Sans, DejaVu Sans" size="35" bold="true" italic="false" valign="center" halign="center"/>
    <title>
      <size minvalue="0,48" maxvalue="0,0"/>
      <border widths="4,4,4,4"/>
      <background color="#FFFFFF"/>
      <text color="#000000" face="Liberation Sans, DejaVu Sans" size="35" bold="true" italic="false" valign="center" halign="center"/>
    </title>
    <client>
      <background color="#FFFFFF"/>
      <text color="#000000" face="Liberation Sans, DejaVu Sans" size="35" bold="true" italic="false" valign="center" halign="left"/>
    </client>
    <item>
      <size minvalue="32,32" maxvalue="0,0"/>
      <border widths="1,2,4,2"/>
      <background color="#FFFFFF"/>
      <text color="#000000" face="Liberation Sans, DejaVu Sans" size="35" bold="true" italic="false" valign="center" halign="center"/>
    </item>
    <selitem>
      <size minvalue="32,32" maxvalue="0,0"/>
      <border widths="6,6,6,6"/>
      <background color="#FFFFFF"/>
      <text color="#000000" face="Liberation Sans, DejaVu Sans" size="35" bold="false" italic="false" valign="center" halign="left"/>
    </selitem>
    <shortcut>
      <size minvalue="20,36" maxvalue="0,0"/>
      <border widths="3,3,3,3"/>
      <background color="#808080"/>
      <text color="#FFFFFF" face="Liberation Sans, DejaVu Sans" size="35" bold="true" italic="false" valign="center" halign="center"/>
    </shortcut>
    <selshortcut>
      <size minvalue="20,32" maxvalue="0,0"/>
      <border widths="12,6,6,6"/>
      <background color="#FFFFFF"/>
      <text color="#000000" face="Liberation Sans, DejaVu Sans" size="48" bold="true" italic="false" valign="center" halign="center"/>
    </selshortcut>
    <scroll base="#menuscroll"/>
  </menu>

  <menu id="t9input">
    <border widths="12,8,8,5"/>
    <background image="cr3_t9_frame.png"/>
    <text color="#000000" face="Liberation Sans, DejaVu Sans" size="35" bold="true" italic="false" valign="center" halign="center"/>
    <title>
      <size minvalue="0,0" maxvalue="0,0"/>
    </title>
    <client>
      <border widths="8,2,5,2"/>
      <background image="cr3_t9_input.png"/>
      <text color="#000000" face="Liberation Sans, DejaVu Sans" size="31" bold="true" italic="false" valign="center" halign="left"/>
    </client>
    <item>
      <size minvalue="32,32" maxvalue="0,0"/>
      <border widths="1,2,4,2"/>
      <background color="#FFFFFF"/>
      <text color="#000000" face="Liberation Sans, DejaVu Sans" size="25" bold="false" italic="false" valign="center" halign="left"/>
    </item>
    <selitem>
      <size minvalue="32,32" maxvalue="0,0"/>
      <border widths="6,6,6,6"/>
      <background color="#FFFFFF"/>
      <text color="#000000" face="Liberation Sans, DejaVu Sans" size="35" bold="false" italic="false" valign="center" halign="left"/>
    </selitem>
    <shortcut>
      <size minvalue="20,36" maxvalue="0,0"/>
      <border widths="3,3,3,3"/>
      <background image="cr3_t9_shortcut.png" color="#FFFFFF"/>
      <text color="#FFFFFF" face="Liberation Sans, DejaVu Sans" size="35" bold="false" italic="false" valign="center" halign="center"/>
    </shortcut>
    <selshortcut>
      <size minvalue="20,32" maxvalue="0,0"/>
      <border widths="12,6,6,6"/>
      <background image="cr3_t9_shortcut.png" color="#FFFFFF"/>
      <text color="#000000" face="Liberation Sans, DejaVu Sans" size="48" bold="true" italic="false" valign="center" halign="center"/>
    </selshortcut>
    <scroll base="#menuscroll"/>
  </menu>
</CR3Skin>
